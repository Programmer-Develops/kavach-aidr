# ==============================================================================
# KAVACH-AIDR — Git Ignore Rules
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.installed.cfg
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- LLM Models & Heavy Weights (Download separately via models/DOWNLOAD.md) ---
models/*.gguf
models/*.bin
models/*.safetensors
models/*.pt
models/*.pth
models/*.onnx
*.gguf
*.bin
*.safetensors

# --- Database, Audit & Generated Reports ---
audit/kavach_audit.db
*.db
*.sqlite
*.sqlite3
reports/
*.cef
*.syslog

# --- Environment, Secrets & Credentials ---
.env
.env.local
.env.*.local
*.env
secrets.json
*.key
*.pem
*.secret

# --- Patch Backups & Temporary Diff Artifacts ---
*.original.py
*.orig
*.rej
*.patch
*.diff

# --- Logs & Diagnostics ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.coverage
.tox/
.nox/
.hypothesis/

# --- UI / Frontend (React / Vite / Node) ---
node_modules/
ui/node_modules/
ui/dist/
ui/build/
.npm/
.eslintcache

# --- IDE & OS Specific ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
